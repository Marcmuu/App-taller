# ─── Backend ────────────────────────────────────────────────────────────────
# "mock"     → BBDD de prueba en el navegador (sin servidor; demo de GitHub Pages)
# "supabase" → base de datos real (Supabase)
NEXT_PUBLIC_BACKEND=supabase

# ─── Supabase ───────────────────────────────────────────────────────────────
# Local:  npx supabase start  (los valores salen en `npx supabase status`)
# Nube:   Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<clave publishable / anon>

# Solo para scripts de administración (npm run db:demo). NUNCA en el navegador
# ni con prefijo NEXT_PUBLIC_. En Vercel no hace falta.
SUPABASE_SERVICE_ROLE_KEY=<clave service_role / secret>

# ─── Demo ───────────────────────────────────────────────────────────────────
# true  → cuentas de prueba, botón «Demo» y reinicio de datos
# false → producción para un cliente real
NEXT_PUBLIC_DEMO_MODE=true

# ─── Avisos en el móvil (Web Push) ──────────────────────────────────────────
# Clave pública VAPID (no es secreta). Genérala con: npm run db:demo -- push-keys
# Sin ella, los avisos salen solo con la app abierta.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
